<%- include('../partials/topo') %>
<section class="tela">
  <a class="voltar" href="/servicos?categoria=<%= servico.categoria_slug %>"><svg class="ic" aria-hidden="true"><use href="#i-voltar"/></svg>Voltar</a>
  <div class="detalhe">
    <div class="capa cat-<%= servico.categoria_slug %>">
      <svg class="ic" aria-hidden="true"><use href="#i-<%= ICONES_CATEGORIA[servico.categoria_slug] %>"/></svg>
      <span><%= servico.categoria_nome %></span>
    </div>
    <div class="detalhe-info">
      <h1><%= servico.titulo %></h1>
      <p class="preco grande"><%= formatarPreco(servico.preco) %> <small>valor base</small></p>
      <a class="prestador-mini" href="/prestadores/<%= servico.prestador_id %>">
        <span class="avatar"><%= iniciais(servico.prestador_nome) %></span>
        <span>
          <strong><%= servico.prestador_nome %></strong>
          <span class="meta">
            <% if (servico.total_avaliacoes) { %>
              <%- include('../partials/estrelas', { media: servico.media_avaliacoes }) %>
              <%= servico.media_avaliacoes.toFixed(1).replace('.', ',') %> (<%= servico.total_avaliacoes %> <%= servico.total_avaliacoes === 1 ? 'avaliação' : 'avaliações' %>)
            <% } else { %>Novo na plataforma<% } %>
          </span>
        </span>
      </a>
      <h2>Descrição</h2>
      <p class="pre"><%= servico.descricao %></p>
      <ul class="fatos">
        <li><svg class="ic" aria-hidden="true"><use href="#i-relogio"/></svg><%= servico.disponibilidade %></li>
        <li><svg class="ic" aria-hidden="true"><use href="#i-local"/></svg>Atende: <%= servico.area_atendimento %></li>
      </ul>
      <% if (!usuario || usuario.tipo === 'cliente') { %>
        <a class="btn btn-primario btn-bloco" href="/servicos/<%= servico.id %>/solicitar">Solicitar contratação</a>
      <% } %>
    </div>
  </div>

  <% if (avaliacoes.length) { %>
    <h2>Avaliações recentes do prestador</h2>
    <ul class="avaliacoes">
      <% avaliacoes.forEach((a) => { %>
        <li>
          <div><%- include('../partials/estrelas', { media: a.nota }) %> <strong><%= primeiroNome(a.cliente_nome) %></strong> <span class="meta">· <%= a.servico_titulo %></span></div>
          <% if (a.comentario) { %><p><%= a.comentario %></p><% } %>
        </li>
      <% }) %>
    </ul>
    <a href="/prestadores/<%= servico.prestador_id %>">Ver perfil completo</a>
  <% } %>
</section>
<%- include('../partials/fim') %>
