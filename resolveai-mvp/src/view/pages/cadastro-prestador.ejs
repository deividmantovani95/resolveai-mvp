<%- include('../partials/topo') %>
<section class="tela tela-estreita">
  <h1>Criar perfil de prestador</h1>
  <p class="sub">Divulgue seus serviços e receba solicitações de clientes da sua região. Seu cadastro passa por uma aprovação antes de aparecer nas buscas.</p>
  <form method="post" action="/cadastro/prestador" class="form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <%- include('../partials/form-dados-pessoais', { dados, erros, comSenha: true }) %>
    <%- include('../partials/form-perfil-prestador', { dados, erros }) %>
    <%- include('../partials/aceite', { erros }) %>
    <button class="btn btn-primario btn-bloco">Cadastrar prestador</button>
  </form>
  <p class="centro espaco sub">Já possui conta? <a href="/login">Entrar</a></p>
</section>
<%- include('../partials/fim') %>
