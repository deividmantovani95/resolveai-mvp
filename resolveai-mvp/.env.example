# Copie este arquivo para .env e ajuste os valores
PORT=3000
APP_NAME=ResolveAí
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resolveai
# Use true em bancos na nuvem que exigem SSL (Neon, Render, Supabase)
DATABASE_SSL=false
# Gere uma frase longa e aleatória (obrigatória em produção)
SESSION_SECRET=troque-esta-frase-por-uma-longa-e-aleatoria
CONTATO_PRIVACIDADE=privacidade@exemplo.com.br
NODE_ENV=development
