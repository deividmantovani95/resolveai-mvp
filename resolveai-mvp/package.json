{
  "name": "resolveai-tg",
  "version": "1.0.0",
  "description": "MVP do TG - plataforma de contratação de serviços de manutenção residencial e suporte técnico (arquitetura MVCP)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "node db/aplicar-schema.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/aplicar-schema.js && node db/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
